                    <div className="text-center">
                      <Video className="w-12 h-12 text-white/50 mx-auto mb-2" />
                      <p className="text-white text-sm">Field Camera 1</p>
                      <span className="inline-block px-2 py-1 bg-red-500 text-white text-xs rounded-full mt-2">🔴 LIVE</span>
