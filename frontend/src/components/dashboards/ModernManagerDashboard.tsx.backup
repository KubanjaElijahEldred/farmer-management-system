  // Field Officer data
  const fieldOfficers = [
    { id: 1, name: 'Michael Brown', farmers: 42, inspections: 156, pending: 7, efficiency: 92 },
    { id: 2, name: 'Sarah Johnson', farmers: 38, inspections: 142, pending: 5, efficiency: 89 },
    { id: 3, name: 'David Wilson', farmers: 45, inspections: 168, pending: 9, efficiency: 95 },
    { id: 4, name: 'Emily Davis', farmers: 40, inspections: 149, pending: 6, efficiency: 91 },
  ];

