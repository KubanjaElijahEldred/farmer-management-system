                      <p className="text-white text-sm">Barn Camera 2</p>
                      <span className="inline-block px-2 py-1 bg-red-500 text-white text-xs rounded-full mt-2">🔴 LIVE</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

